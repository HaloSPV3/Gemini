{
  "name": "spv3-loader",
  "description": "Automate commit messages quality, changelog generation, and release creation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "husky",
    "build": "dotnet build && dotnet build -c:Release",
    "test": "dotnet test",
    "prepare": "husky",
    "release": "semantic-release --debug",
    "restore": "dotnet restore && dotnet restore -p:Configuration=Release",
    "sdks": "yarn dlx @yarnpkg/sdks"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/types": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@halospv3/hce.shared-config": "^3.11.2",
    "@types/node": "^24.13.3",
    "commitlint": "^20.5.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  },
  "packageManager": "yarn@4.17.1+sha512.ccbfabf7d7b6b32075088be9386fb9a2e00bb6887ef07fa56effabc890a56d53da1ccc4128d62db245fcbd3961b236d75335bdf7d5320ed6eafb7588b7ad4697"
}
