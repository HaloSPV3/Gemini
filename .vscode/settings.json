{
  "[javascript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[json]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[json5]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "files.associations": {
    "**/.vscode/*.json": "jsonc",
    "**/*.xaml": "xaml"
  },
  "xml.codeLens.enabled": true,
  "github-actions.workflows.pinned.workflows": [
    ".github/workflows/release.yml",
    ".github/workflows/ci.yml"
  ],
  "devskim.ignoreRulesList": [
    "DS187371"
  ],
  "markdownlint.config": {
    "MD025": {
      "front_matter_title": ""
    },
    "MD028": false
  },
  "eslint.nodePath": ".yarn/sdks",
  "js/ts.tsdk.path": ".yarn/sdks/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "search.exclude": {
    "**/.yarn": true,
    "**/.pnp.*": true
  },
  "cSpell.words": [
    "_wpftmp",
    "buildtransitive",
    "contentfiles",
    "ControlzEx",
    "halospv3",
    "Initialise",
    "Meziantou",
    "resx",
    "snupkg"
  ]
}
